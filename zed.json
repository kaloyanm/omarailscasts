                "color": "#a6e22e"
              },
              "function": {
                "color": "#a1bfa6"
              },
              "keyword": {
                "color": "#6d9cbe"
              },
              "number": {
                "color": "#967efb"
              },
              "operator": {
                "color": "#6d9cbe"
              },
              "string": {
                "color": "#da4939"
              },
              "variable": {
                "color": "#a5c261"
              }
            },
            "players": [
              {
                "cursor": "#e6e1dc",
