            "terminal.ansi.black": "#282828",
            "terminal.ansi.red": "#da4939",
            "terminal.ansi.green": "#a5c261",
            "terminal.ansi.yellow": "#e8bf6a",
            "terminal.ansi.blue": "#6d9cbe",
            "terminal.ansi.magenta": "#967efb",
            "terminal.ansi.cyan": "#89af90",
            "terminal.ansi.white": "#ffffff",
            "terminal.ansi.bright_black": "#bc9458",
            "terminal.ansi.bright_red": "#f92672",
            "terminal.ansi.bright_green": "#a6e22e",
            "terminal.ansi.bright_yellow": "#ffc66d",
            "terminal.ansi.bright_blue": "#83abc8",
